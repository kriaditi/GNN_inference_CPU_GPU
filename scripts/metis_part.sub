#!/bin/bash
#SBATCH --job-name=metispart
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/metispart_k%a_%j.out
#SBATCH -e logs/metispart_k%a_%j.err
#SBATCH --get-user-env
#SBATCH --mem=400G
#SBATCH -t 48:00:00
#SBATCH --cpus-per-task=8
#SBATCH --partition=gupta
#SBATCH --nodelist=yosemite
#SBATCH --array=4,5,8,16%2

# Stage 2 of METIS: one array task per k (k = SLURM_ARRAY_TASK_ID), two at a
# time on yosemite. Loads the saved graph (30 GB) and runs METIS_PartGraphKway
# (serial, 64-bit); writes part_k{k}.npy and part_k{k}.json with sizes in GB,
# edge cut and within-part edge fractions per relation.
# Submit after the build job: sbatch --dependency=afterok:<buildjob> scripts/metis_part.sub

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export METIS_HOME=$HOME/local
export LD_LIBRARY_PATH=$METIS_HOME/lib:$LD_LIBRARY_PATH
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

K=$SLURM_ARRAY_TASK_ID
echo "job $SLURM_JOB_ID k=$K on $(hostname)  $(date)"
python metis_partition.py --k $K --out /share/gupta/ak2877/gnn/metis
echo "exit $?  $(date)"
cat /share/gupta/ak2877/gnn/metis/part_k${K}.json | head -40
