#!/bin/bash
#SBATCH --job-name=cpu_big
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/cpu_big_%j.out
#SBATCH -e logs/cpu_big_%j.err
#SBATCH --get-user-env
#SBATCH --mem=450G
#SBATCH -t 04:00:00
#SBATCH --partition=gupta
#SBATCH --nodelist=rocky
#SBATCH --cpus-per-task=32

# CPU-only at batch sizes the L4 cannot hold (its ceiling is ~1.2M nodes,
# batch 16384). 32 cores, threads pinned to the allocation.
# batch 16384 is repeated so the 32-core number sits next to the 8- and
# 48-core ones already in summary.csv.

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "job $SLURM_JOB_ID on $(hostname)  $(date)"
free -g

for BATCH in 16384 32768 65536; do
  echo "### cpu batch=$BATCH  $(date +%T)"
  python sage_mag240m.py \
    --seeds 88092 --fanout 15,10 --layers 2 \
    --batch-size $BATCH --iters 3 --warmup 1 \
    --in-memory --device cpu \
    --out results --tag "cpu32_b${BATCH}_f15x10_${SLURM_JOB_ID}"
  echo "### exit $?  $(date +%T)"
done

ARCHIVE=/share/gupta/ak2877/gnn/results/cpu_big_${SLURM_JOB_ID}
mkdir -p "$ARCHIVE"
cp results/cpu32_*_${SLURM_JOB_ID}_periter.csv results/summary.csv \
   logs/cpu_big_${SLURM_JOB_ID}.* sage_mag240m.py "$ARCHIVE/" 2>/dev/null
echo "archived to $ARCHIVE"
