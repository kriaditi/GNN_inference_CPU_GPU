#!/bin/bash
#SBATCH --job-name=metisbuild
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/metisbuild_%j.out
#SBATCH -e logs/metisbuild_%j.err
#SBATCH --get-user-env
#SBATCH --mem=500G
#SBATCH -t 06:00:00
#SBATCH --cpus-per-task=8
#SBATCH --partition=gupta
#SBATCH --nodelist=yosemite

# Stage 1 of METIS: build the global undirected hetero graph (244M vertices,
# ~1.7B undirected edges) once and save xadj/adjncy (~30 GB) to
# /share/gupta/ak2877/gnn/metis/. Peak RAM ~150 GB during dedup; 500 GB
# requested for headroom. No GPU.

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export METIS_HOME=$HOME/local
export LD_LIBRARY_PATH=$METIS_HOME/lib:$LD_LIBRARY_PATH
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "job $SLURM_JOB_ID on $(hostname)  $(date)"
python metis_partition.py --build --out /share/gupta/ak2877/gnn/metis
echo "exit $?  $(date)"
ls -lh /share/gupta/ak2877/gnn/metis/
