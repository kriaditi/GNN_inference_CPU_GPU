#!/bin/bash
#SBATCH --job-name=recall
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/recall_%j.out
#SBATCH -e logs/recall_%j.err
#SBATCH --get-user-env
#SBATCH --mem=64G
#SBATCH -t 04:00:00
#SBATCH --partition=gupta
#SBATCH --nodelist=rocky
#SBATCH --cpus-per-task=8

# Neighbourhood recall vs fanout: exact 2-hop ground truth from the CSR
# against the sampled neighbourhood, 2000 test-dev seeds. CSR only.

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "job $SLURM_JOB_ID on $(hostname)  $(date)"
TAG=recall_testdev2000_${SLURM_JOB_ID}

python recall_fanout.py --seeds 2000 \
  --fanouts 5,5 10,5 15,10 25,15 40,20 100,50 \
  --out results/$TAG

ARCHIVE=/share/gupta/ak2877/gnn/results/recall_${SLURM_JOB_ID}
mkdir -p "$ARCHIVE"
cp results/${TAG}.csv logs/recall_${SLURM_JOB_ID}.* recall_fanout.py "$ARCHIVE/"
echo "archived to $ARCHIVE"
