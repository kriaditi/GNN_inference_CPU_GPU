#!/bin/bash
#SBATCH --job-name=hetcsr
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/hetcsr_%j.out
#SBATCH -e logs/hetcsr_%j.err
#SBATCH --get-user-env
#SBATCH --mem=64G
#SBATCH -t 03:00:00
#SBATCH --cpus-per-task=8
#SBATCH --partition=gupta
#SBATCH --nodelist=rocky

# Build the hetero CSRs (author<->paper, author<->institution, both
# directions) into /share/gupta/ak2877/gnn/csr_hetero. CPU only, ~15 GB peak.

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "job $SLURM_JOB_ID on $(hostname)  $(date)"
python build_hetero_csr.py \
  --root /share/gupta/ak2877/gnn/data \
  --out  /share/gupta/ak2877/gnn/csr_hetero
echo "exit $?  $(date)"
ls -lh /share/gupta/ak2877/gnn/csr_hetero/
