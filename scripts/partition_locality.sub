#!/bin/bash
#SBATCH --job-name=partloc
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
#SBATCH -o logs/partloc_%j.out
#SBATCH -e logs/partloc_%j.err
#SBATCH --get-user-env
#SBATCH --mem=80G
#SBATCH -t 04:00:00
#SBATCH --cpus-per-task=8
#SBATCH --partition=gupta

# Batch-level partition locality: for each k with a part_k{k}.npy present,
# fanouts 5,5 / 15,10 / 40,20, grouped vs random seeds, 200 batches of 1024.
# CPU only (30 GB of CSRs + part files). Writes results/partition/locality_k*.csv
# and locality_summary.json. Re-run later with --ks 6,16 when those finish.

source /share/apps/software/anaconda3/etc/profile.d/conda.sh
conda activate gnn
cd ~/gnn
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "job $SLURM_JOB_ID on $(hostname)  $(date)"
python partition_locality.py --ks ${KS:-4,5,8} --fanouts 5/5,15/10,40/20 \
  --batches 200 --batch-size 1024 --out results/partition
echo "exit $?  $(date)"
